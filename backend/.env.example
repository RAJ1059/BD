# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_NAME="Business Direction Admin"
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5175

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/bd_admin

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_EXPIRES_REMEMBER_ME=30d

# ---------------------------------------------------------------------------
# Cookies
# ---------------------------------------------------------------------------
COOKIE_SECRET=change_this_cookie_secret

# ---------------------------------------------------------------------------
# Super Admin (seed)
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_EMAIL=superadmin@businessdirection.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe@12345

# ---------------------------------------------------------------------------
# File storage: "local", "s3", or "cloudinary"
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# AWS S3 (only needed when STORAGE_DRIVER=s3)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Cloudinary (only needed when STORAGE_DRIVER=cloudinary)
# Find these on your Cloudinary dashboard: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: a single connection string alternative to the three keys above (cloudinary://api_key:api_secret@cloud_name)
CLOUDINARY_URL=
CLOUDINARY_FOLDER=business-direction

# ---------------------------------------------------------------------------
# Email - MAIL_DRIVER selects "smtp" (default), "sendgrid", "mailgun", or "ses".
# Leave the selected driver's credentials blank to run in "disabled" mode
# (logs instead of sends).
# ---------------------------------------------------------------------------
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Business Direction <no-reply@businessdirection.com>"

# SendGrid (only needed when MAIL_DRIVER=sendgrid)
SENDGRID_API_KEY=

# Mailgun (only needed when MAIL_DRIVER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Amazon SES (only needed when MAIL_DRIVER=ses); falls back to AWS_REGION if unset
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Notifications (Slack/Discord webhooks) - leave blank to skip silently
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Optional integrations - all stubbed until keys are provided
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANALYTICS_PROPERTY_ID=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
WHATSAPP_BUSINESS_TOKEN=
GOHIGHLEVEL_API_KEY=
MAILCHIMP_API_KEY=
